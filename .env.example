# Copy to .env for local development (never commit .env).

# Port for the Express API / production server
PORT=5000

# Gemini API key: enables the AI crop scanner and the online chat answers.
# Server-side only; do NOT prefix it with VITE_ (that would expose it in the browser bundle).
GEMINI_API_KEY=

# Optional: override the Gemini model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Optional but recommended in production: browser origins allowed to call the API,
# comma separated. Leave unset only for local development.
# ALLOWED_ORIGINS=https://your-username.github.io

# Build-time (frontend only): URL of the hosted API when the site is on static hosting
# such as GitHub Pages. Set it as a GitHub Actions *variable* named VITE_API_BASE_URL.
# VITE_API_BASE_URL=https://your-api.onrender.com
